# swagpc-custom.rules
# Custom Suricata IDS rules for SwagPc Café capstone lab.
# These rules detect the specific attack scenarios demonstrated in this project.

# ─── Reconnaissance ───────────────────────────────────────────────
alert tcp $GUEST_NET any -> $BUSINESS_NET any (msg:"SWAGPC RECON Nmap SYN scan from Guest network"; flags:S; threshold: type threshold, track by_src, count 20, seconds 5; classtype:network-scan; sid:9000001; rev:1;)

alert icmp $GUEST_NET any -> $BUSINESS_NET any (msg:"SWAGPC RECON ICMP ping sweep from Guest to Business"; itype:8; threshold: type threshold, track by_src, count 5, seconds 3; classtype:network-scan; sid:9000002; rev:1;)

alert tcp $GUEST_NET any -> $BUSINESS_NET any (msg:"SWAGPC RECON Port scan - multiple ports from Guest"; flags:S; threshold: type both, track by_src, count 15, seconds 10; classtype:network-scan; sid:9000003; rev:1;)

# ─── Web Application Attacks ──────────────────────────────────────
alert http $GUEST_NET any -> $BUSINESS_NET $HTTP_PORTS (msg:"SWAGPC WEB SQL Injection attempt from Guest network"; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:9000010; rev:1;)

alert http $GUEST_NET any -> $BUSINESS_NET $HTTP_PORTS (msg:"SWAGPC WEB Command Injection attempt - semicolon payload"; http.request_body; content:";"; pcre:"/;\s*(cat|ls|id|whoami|pwd|etc\/passwd)/i"; classtype:web-application-attack; sid:9000011; rev:1;)

alert http $GUEST_NET any -> $BUSINESS_NET $HTTP_PORTS (msg:"SWAGPC WEB DVWA Command Injection - /etc/passwd exfil"; http.request_body; content:"etc/passwd"; classtype:web-application-attack; sid:9000012; rev:1;)

alert http $GUEST_NET any -> $BUSINESS_NET $HTTP_PORTS (msg:"SWAGPC WEB Cross-Site Scripting attempt from Guest"; http.uri; content:"<script>"; nocase; classtype:web-application-attack; sid:9000013; rev:1;)

# ─── Lateral Movement ─────────────────────────────────────────────
alert tcp $GUEST_NET any -> $BUSINESS_NET 445 (msg:"SWAGPC LATERAL SMB access attempt from Guest to Business"; classtype:policy-violation; sid:9000020; rev:1;)

alert tcp $GUEST_NET any -> $BUSINESS_NET 3389 (msg:"SWAGPC LATERAL RDP access attempt from Guest to Business"; classtype:policy-violation; sid:9000021; rev:1;)

alert tcp $GUEST_NET any -> $BUSINESS_NET 22 (msg:"SWAGPC LATERAL SSH access attempt from Guest to Business"; classtype:policy-violation; sid:9000022; rev:1;)
