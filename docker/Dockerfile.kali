FROM kalilinux/kali-rolling:latest@sha256:69a9a33d98a584a537bd0f7144d20c3b6d23f3bafa9ffcf0cadf4c5f186d02ff

RUN apt-get update && apt-get install -y --no-install-recommends \
    iputils-ping \
    iproute2 \
    arp-scan \
    curl \
    nmap \
    netcat-traditional \
    dnsutils \
    sqlmap \
    nikto \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /scripts

CMD ["sleep", "infinity"]
