# Dockerfile.firewall
# US-17 (#127): the simulated pfSense router. iptables is installed at build time, not at container start,
# so the FORWARD rules can be set the moment the container starts and no packet is routed before them.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache iptables iproute2 tcpdump
